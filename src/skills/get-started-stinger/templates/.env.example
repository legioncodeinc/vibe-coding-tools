# Copy to .env and fill in real values. .env.example is committed on purpose
# (it documents required configuration); .env itself is gitignored and must
# never contain real secrets in version control.
#
# Reference: raw/get-started--secret-scanning--push-protection-official-docs.md
# .gitignore is the first layer of defense; push protection (a repo Settings
# toggle, see guide 04) is the second: this file is what makes the first
# layer possible without anyone guessing what variables exist.

# ---- Runtime ----
NODE_ENV={development|production|test}
PORT={port_number}

# ---- Application ----
{APP_SPECIFIC_VAR}={example_value}

# ---- Third-party services ----
# Never put a real API key here. Use an obviously fake placeholder so a
# copy-paste mistake fails loudly instead of silently working.
{SERVICE}_API_KEY=replace-me
{SERVICE}_BASE_URL=https://example.invalid

# ---- Database ----
DATABASE_URL=postgres://user:password@localhost:5432/{database_name}
